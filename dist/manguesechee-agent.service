[Unit]
Description=Manguesechee KVM Agent
Documentation=https://github.com/manguesechee/manguesechee
After=graphical-session.target network.target

[Service]
Type=simple
ExecStart=/usr/bin/manguesechee-agent
Restart=on-failure
RestartSec=5s
Environment=RUST_LOG=info
PassEnvironment=DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR XDG_SESSION_TYPE XAUTHORITY

[Install]
WantedBy=default.target
