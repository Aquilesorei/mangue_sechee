import { Button, HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component HeaderBar inherits Rectangle {
    in property <int> active-tab: 0;
    in property <string> status: "Ready";
    in property <bool> is-service-running: true;
    in property <bool> cursor-locked: false;
    in property <bool> tls-active: false;
    in property <string> connected-peer: "";

    callback toggle-cursor-lock();
    callback start-service();
    callback stop-service();
    callback restart-service();
    callback hide-to-tray();

    height: 52px;
    background: Theme.surface-card;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border-subtle;

    HorizontalBox {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        Text {
            text: root.active-tab == 0 ? "Peers & Connections"
                : (root.active-tab == 1 ? "Screen Topology Layout"
                : (root.active-tab == 4 ? "File Transfers & History"
                : (root.active-tab == 2 ? "System Settings" : "System Logs")));
            font-size: 16px;
            font-weight: 700;
            color: Theme.text-primary;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        // TLS Security Pill (when connected)
        if root.connected-peer != "" : Rectangle {
            background: root.tls-active ? Theme.success-bg : Theme.warning-bg;
            border-radius: 12px;
            height: 28px;
            border-width: 1px;
            border-color: root.tls-active ? Theme.success-border : Theme.warning-border;

            HorizontalBox {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.tls-active ? Theme.success : Theme.warning;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.tls-active ? "TLS Active" : "Unencrypted";
                    font-size: 11px;
                    font-weight: 600;
                    color: root.tls-active ? Theme.success-text : Theme.warning-text;
                    vertical-alignment: center;
                }
            }
        }

        // Status Badge
        Rectangle {
            background: Theme.surface-secondary;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border-subtle;
            height: 28px;

            HorizontalBox {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.is-service-running ? Theme.success : Theme.error;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.is-service-running ? root.status : "Daemon Stopped";
                    font-size: 11px;
                    font-weight: 500;
                    color: root.is-service-running ? Theme.text-primary : Theme.error-text;
                    vertical-alignment: center;
                }
            }
        }

        // Cursor Lock Toggle Button
        Button {
            text: root.cursor-locked ? "Cursor Locked" : "Lock Cursor";
            primary: root.cursor-locked;
            enabled: root.is-service-running;
            clicked => { root.toggle-cursor-lock(); }
        }

        // Minimize to Tray Button
        Button {
            text: "Hide to Tray";
            clicked => { root.hide-to-tray(); }
        }

        // Live Service Controls (Start, Stop, Restart)
        if root.is-service-running : HorizontalBox {
            spacing: 6px;
            Button {
                text: "Restart";
                clicked => { root.restart-service(); }
            }
            Button {
                text: "Stop";
                clicked => { root.stop-service(); }
            }
        }
        if !root.is-service-running : Button {
            text: "Start Daemon";
            primary: true;
            clicked => { root.start-service(); }
        }
    }
}
