import { VerticalBox, HorizontalBox, GroupBox, Switch, ProgressIndicator, ScrollView } from "std-widgets.slint";
import { TransferItem, HistoryItem } from "../types.slint";
import { Theme } from "../theme.slint";

export component TransfersView inherits ScrollView {
    in-out property <bool> setting-file-transfer: true;
    in property <[TransferItem]> active-transfers: [];
    in property <[HistoryItem]>  transfer-history: [];

    callback toggle-file-transfer(bool);

    vertical-stretch: 1;

    VerticalBox {
        spacing: 14px;
        padding-right: 10px;

        // Info banner with toggle switch
        Rectangle {
            background: Theme.surface-card;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-subtle;

            HorizontalBox {
                padding: 14px;
                spacing: 16px;

                VerticalBox {
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: "Clipboard File Transfers";
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: root.setting-file-transfer
                            ? "Copy files in any desktop file manager, move mouse across screens, and paste with Ctrl+V."
                            : "File transfers are currently paused.";
                        font-size: 12px;
                        color: root.setting-file-transfer ? Theme.text-secondary : Theme.warning-text;
                        wrap: word-wrap;
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: "File Transfers:";
                        font-size: 13px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    Switch {
                        text: root.setting-file-transfer ? "Enabled" : "Disabled";
                        checked <=> root.setting-file-transfer;
                        toggled => { root.toggle-file-transfer(self.checked); }
                    }
                }
            }
        }

        // Active Transfers
        GroupBox {
            title: "Active Transfers";
            VerticalBox {
                spacing: 8px;

                for item[i] in root.active-transfers : Rectangle {
                    background: Theme.surface-card;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalBox {
                        padding: 10px;
                        spacing: 8px;

                        HorizontalBox {
                            spacing: 10px;
                            Rectangle {
                                width: 70px;
                                height: 20px;
                                border-radius: 4px;
                                background: item.is-receiving ? Theme.accent-subtle : Theme.primary-subtle;
                                border-width: 1px;
                                border-color: item.is-receiving ? Theme.accent-indigo : Theme.primary-border;

                                Text {
                                    text: item.is-receiving ? "Incoming" : "Outgoing";
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: item.is-receiving ? Theme.accent-text : Theme.primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: item.name;
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: item.size-text;
                                font-size: 12px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: item.status-text;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.accent-indigo;
                                vertical-alignment: center;
                            }
                        }

                        ProgressIndicator {
                            progress: item.progress;
                        }
                    }
                }

                if !root.setting-file-transfer : Text {
                    text: "File transfer is currently disabled.";
                    color: Theme.warning-text;
                    font-size: 13px;
                    horizontal-alignment: center;
                }

                if root.setting-file-transfer && root.active-transfers.length == 0 : Text {
                    text: "No active transfers. Files transfer automatically when copied to clipboard.";
                    color: Theme.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }

        // Transfer History
        GroupBox {
            title: "Recent Transfer History";
            VerticalBox {
                spacing: 6px;

                for entry[i] in root.transfer-history : Rectangle {
                    background: Theme.surface-card;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    height: 40px;

                    HorizontalBox {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;

                        Rectangle {
                            width: 60px;
                            height: 18px;
                            border-radius: 4px;
                            background: Theme.surface-secondary;

                            Text {
                                text: entry.is-receiving ? "Received" : "Sent";
                                font-size: 10px;
                                font-weight: 600;
                                color: Theme.text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: entry.name;
                            font-size: 13px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text {
                            text: entry.size-text;
                            font-size: 12px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                        Text {
                            text: entry.time-text;
                            font-size: 11px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.transfer-history.length == 0 : Text {
                    text: "No transfer history yet.";
                    color: Theme.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
