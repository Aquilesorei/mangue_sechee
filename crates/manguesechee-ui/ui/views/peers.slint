import { Button, VerticalBox, HorizontalBox, GroupBox, LineEdit, ScrollView, ComboBox } from "std-widgets.slint";
import { PeerEntry } from "../types.slint";
import { Theme } from "../theme.slint";

export component PeersView inherits VerticalBox {
    in property <string> role-label: "Server + Client (Both)";
    in property <string> local-ip: "127.0.0.1";
    in property <string> setting-port: "24800";
    in property <bool> discovery: true;
    in property <string> connected-peer: "";
    in property <bool> topology-configured: false;
    in-out property <string> topology-notice: "";
    in-out property <string> connection-error: "";
    in property <bool> is-service-running: true;
    in property <bool> setting-tls: false;
    in property <bool> tls-active: false;
    in property <[PeerEntry]> peers: [];

    callback configure-topology-clicked();
    callback dismiss-error();
    callback open-connect-modal();
    callback open-unpair-modal(string);
    callback open-rename-modal(string, string);
    callback connect-requested(string);
    callback disconnect-requested();
    callback ping-peer(string);
    callback forget-peer(string);
    callback update-peer-position(string, string);

    spacing: 12px;
    vertical-stretch: 1;

    // ── Machine & Network Status Overview Card ───────────────────────────────
    Rectangle {
        height: 68px;
        background: Theme.surface-card;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border-subtle;

        HorizontalBox {
            padding: 12px;
            spacing: 16px;

            VerticalBox {
                spacing: 2px;
                Text { text: "Active Role"; font-size: 11px; color: Theme.text-muted; }
                Text { text: root.role-label; font-size: 13px; font-weight: 600; color: Theme.text-primary; }
            }
            Rectangle { width: 1px; background: Theme.border-subtle; }
            VerticalBox {
                spacing: 2px;
                Text { text: "Local Address"; font-size: 11px; color: Theme.text-muted; }
                Text { text: root.local-ip + ":" + root.setting-port; font-size: 13px; font-weight: 700; color: Theme.primary; }
            }
            Rectangle { width: 1px; background: Theme.border-subtle; }
            VerticalBox {
                spacing: 2px;
                Text { text: "Auto-Discovery"; font-size: 11px; color: Theme.text-muted; }
                Text {
                    text: root.discovery ? "mDNS Active" : "Disabled";
                    font-size: 13px;
                    font-weight: 600;
                    color: root.discovery ? Theme.success : Theme.warning;
                }
            }
            Rectangle { width: 1px; background: Theme.border-subtle; }
            VerticalBox {
                spacing: 2px;
                Text { text: "Security (TLS)"; font-size: 11px; color: Theme.text-muted; }
                Text {
                    text: root.setting-tls ? "TLS Active" : "Disabled";
                    font-size: 13px;
                    font-weight: 600;
                    color: root.setting-tls ? Theme.success : Theme.warning;
                }
            }
            Rectangle { horizontal-stretch: 1; }

            // Action button to open connect modal
            Button {
                text: "+ Connect Machine";
                primary: true;
                enabled: root.is-service-running;
                clicked => { root.open-connect-modal(); }
            }
        }
    }

    // ── Connection Success Banner ────────────────────────────────────────────
    if root.connected-peer != "" && !root.topology-configured : Rectangle {
        background: Theme.success-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.success-border;

        HorizontalBox {
            padding: 12px;
            spacing: 14px;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.success;
                y: (parent.height - self.height) / 2;
            }

            VerticalBox {
                spacing: 2px;
                horizontal-stretch: 1;

                HorizontalBox {
                    spacing: 8px;
                    Text {
                        text: "Connected to " + root.connected-peer;
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.success-text;
                    }
                    Rectangle {
                        background: root.tls-active ? Theme.success-bg : Theme.warning-bg;
                        border-radius: 4px;
                        height: 18px;
                        border-width: 1px;
                        border-color: root.tls-active ? Theme.success-border : Theme.warning-border;

                        HorizontalBox {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: root.tls-active ? "TLS Encrypted" : "Unencrypted";
                                font-size: 10px;
                                font-weight: 700;
                                color: root.tls-active ? Theme.success-text : Theme.warning-text;
                            }
                        }
                    }
                }
                Text {
                    text: root.tls-active
                        ? "Seamless control is active with TLS encryption. Configure your screen layout to start edge switching."
                        : "Seamless control is active. Enable TLS in Settings to encrypt network traffic.";
                    font-size: 12px;
                    color: Theme.text-secondary;
                }
            }

            Button {
                text: "Configure Screen Topology";
                primary: true;
                clicked => { root.configure-topology-clicked(); }
            }
        }
    }

    // ── Topology Synced Notice Banner ────────────────────────────────────────
    if root.connected-peer != "" && root.topology-configured && root.topology-notice != "" : Rectangle {
        background: Theme.accent-subtle;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.accent-indigo;

        HorizontalBox {
            padding: 12px;
            spacing: 14px;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent-indigo;
                y: (parent.height - self.height) / 2;
            }

            VerticalBox {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "Screen Topology Configured & Synced";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.accent-text;
                }
                Text {
                    text: root.topology-notice;
                    font-size: 12px;
                    color: Theme.text-secondary;
                }
            }

            Button {
                text: "Adjust Layout";
                clicked => { root.configure-topology-clicked(); }
            }
            Button {
                text: "✕";
                clicked => { root.topology-notice = ""; }
            }
        }
    }

    // ── Connection Error Banner ──────────────────────────────────────────────
    if root.connection-error != "" : Rectangle {
        background: Theme.error-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.error-border;

        HorizontalBox {
            padding: 12px;
            spacing: 14px;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.error;
                y: (parent.height - self.height) / 2;
            }

            VerticalBox {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "Connection Failed";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.error-text;
                }
                Text {
                    text: root.connection-error;
                    font-size: 12px;
                    color: Theme.error-text;
                }
            }

            Button {
                text: "Dismiss";
                clicked => { root.connection-error = ""; root.dismiss-error(); }
            }
        }
    }

    // ── Discovered & Configured Peers List ───────────────────────────────────
    GroupBox {
        title: "Known & Discovered Peers";
        vertical-stretch: 1;

        ScrollView {
            VerticalBox {
                spacing: 8px;
                padding-right: 6px;

                for peer[i] in root.peers : Rectangle {
                    min-height: 72px;
                    background: Theme.surface-card;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalBox {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;

                        // Connection status indicator
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: peer.connected ? Theme.success : (peer.paired ? Theme.warning : Theme.text-muted);
                            y: (parent.height - self.height) / 2;
                        }

                        VerticalBox {
                            alignment: center;
                            spacing: 4px;
                            horizontal-stretch: 1;

                            HorizontalBox {
                                spacing: 8px;
                                Text {
                                    text: peer.display-name != "" ? peer.display-name : peer.name;
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                }
                                if peer.ping-status != "" : Rectangle {
                                    background: Theme.surface-secondary;
                                    border-radius: 4px;
                                    height: 18px;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    HorizontalBox {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: peer.ping-status;
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: Theme.success;
                                        }
                                    }
                                }
                            }
                            Text {
                                text: peer.address;
                                font-size: 11px;
                                color: Theme.text-muted;
                            }
                        }

                        // Screen Side selector
                        Text {
                            text: "Side:";
                            font-size: 12px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            width: 100px;
                            model: ["Right", "Left", "Above", "Below"];
                            current-index: peer.position == "left" ? 1 : (peer.position == "above" ? 2 : (peer.position == "below" ? 3 : 0));
                            selected => { root.update-peer-position(peer.address, self.current-value.to-lowercase()); }
                        }

                        // Rename button
                        Button {
                            text: "Rename";
                            clicked => { root.open-rename-modal(peer.address, peer.display-name != "" ? peer.display-name : peer.name); }
                        }

                        // Ping button
                        Button {
                            text: "Ping";
                            clicked => { root.ping-peer(peer.address); }
                        }

                        // Unpair button (opens confirm dialog)
                        Button {
                            text: "Unpair";
                            clicked => { root.open-unpair-modal(peer.address); }
                        }

                        // Topology button if connected
                        if peer.connected : Button {
                            text: "Layout";
                            clicked => { root.configure-topology-clicked(); }
                        }

                        // Connect / Disconnect button
                        Button {
                            text: peer.connected ? "Disconnect" : "Connect";
                            primary: !peer.connected;
                            enabled: root.is-service-running;
                            clicked => {
                                if peer.connected { root.disconnect-requested(); }
                                else { root.connect-requested(peer.address); }
                            }
                        }
                    }
                }

                if root.peers.length == 0 : VerticalBox {
                    alignment: center;
                    padding: 32px;
                    spacing: 8px;
                    Text {
                        text: "No peers currently detected on the local network.";
                        color: Theme.text-secondary;
                        font-size: 14px;
                        font-weight: 500;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Ensure Manguesechee is running on both machines, or use '+ Connect Machine' above to connect directly.";
                        font-size: 12px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
