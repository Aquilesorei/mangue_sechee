import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { PeerEntry, TransferItem, HistoryItem, AppView } from "types.slint";
import { Theme } from "theme.slint";
import { SetupWizard, ConnectingView } from "views/wizard.slint";
import { Sidebar } from "components/sidebar.slint";
import { HeaderBar } from "components/header.slint";
import { Snackbar } from "components/snackbar.slint";
import { ManualConnectModal, ConfirmModal, PairingPinModal } from "components/dialogs.slint";
import { PeersView } from "views/peers.slint";
import { TopologyView } from "views/topology.slint";
import { TransfersView } from "views/transfers.slint";
import { SettingsView } from "views/settings.slint";
import { LogsView } from "views/logs.slint";

export { PeerEntry, TransferItem, HistoryItem, AppView, Theme }

export component MainWindow inherits Window {
    title: "Manguesechee";
    icon:  @image-url("../../../assets/icons/manguesechee-256.png");
    min-width:  880px;
    min-height: 600px;
    preferred-width: 960px;
    preferred-height: 660px;
    background: Theme.app-bg;

    // ── Application State ───────────────────────────────────────────────────
    in-out property <AppView>     view:               AppView.Main;
    in-out property <int>         active-tab:         0; // 0=Peers, 1=Topology, 2=Settings, 3=Logs, 4=Files
    in-out property <int>         wizard-page:        0;
    in-out property <string>      local-name:         "fedora";
    in-out property <string>      local-ip:           "127.0.0.1";
    in-out property <string>      status:             "Ready";
    in-out property <bool>        is-service-running: true;
    in-out property <string>      role-label:         "Server + Client (Both)";
    in-out property <bool>        discovery:          true;
    in-out property <bool>        cursor-locked:      false;
    in-out property <[PeerEntry]> peers:              [];
    in-out property <[string]>    log-lines:          [];
    in-out property <[TransferItem]> active-transfers: [];
    in-out property <[HistoryItem]>  transfer-history: [];
    in-out property <string>      connected-peer:     "";
    in-out property <string>      connection-error:   "";
    in-out property <bool>        topology-configured: false;
    in-out property <string>      topology-notice:     "";
    in-out property <bool>        is-dark <=> Theme.is-dark;
    callback dismiss-error();

    // ── Toast & Snackbar Properties ─────────────────────────────────────────
    in-out property <bool>        toast-visible:  false;
    in-out property <string>      toast-text:     "";
    in-out property <bool>        toast-is-error: false;
    callback dismiss-toast();

    // ── Modal Properties ────────────────────────────────────────────────────
    in-out property <int>         active-modal:      0; // 0=None, 1=ManualConnect, 2=ConfirmUnpair, 3=PairingPin
    in-out property <string>      modal-target-addr: "";
    in-out property <string>      modal-title:       "";
    in-out property <string>      modal-message:     "";
    in-out property <string>      modal-pin-code:    "482 915";

    // ── Wizard Properties ───────────────────────────────────────────────────
    in-out property <int>         wizard-role:  0;
    in-out property <string>      wizard-addr:  "";
    in-out property <string>      wizard-side:  "right";

    // ── Settings Properties ─────────────────────────────────────────────────
    in-out property <string>      setting-name:         "fedora";
    in-out property <int>         setting-role:         0; // 0=Both, 1=Controller, 2=Peer
    in-out property <string>      setting-port:         "24800";
    in-out property <bool>        setting-discovery:     true;
    in-out property <bool>        setting-clipboard:     true;
    in-out property <bool>        setting-file-transfer: true;
    in-out property <bool>        setting-tls:           false;
    in-out property <bool>        tls-active:            false;
    in-out property <bool>        setting-autostart:     true;
    in-out property <string>      setting-width:         "1920";
    in-out property <string>      setting-height:        "1080";
    in-out property <string>      setting-switch-delay:  "0";
    in-out property <string>      setting-deadzone:      "50";
    in-out property <string>      setting-velocity:      "20";
    in-out property <string>      setting-peer-addr:     "";
    in-out property <string>      setting-peer-pos:      "right";
    in-out property <string>      setting-hotkey-lock:   "ScrollLock";
    in-out property <string>      setting-hotkey-switch: "Ctrl+Alt+Right";
    in-out property <string>      setting-hotkey-escape: "Ctrl+Alt+Escape";
    in-out property <string>      settings-feedback:     "";
    in-out property <string>      logs-feedback:         "";

    // ── Logs Filter Properties ──────────────────────────────────────────────
    in-out property <int>         log-level-filter:     0; // 0=All, 1=Errors, 2=Warnings, 3=Info
    in-out property <string>      log-filter:           "";

    // ── Callbacks ───────────────────────────────────────────────────────────
    callback tab-selected(int);
    callback connect-requested(string);
    callback disconnect-requested();
    callback toggle-discovery(bool);
    callback toggle-file-transfer(bool);
    callback toggle-tls(bool);
    callback toggle-cursor-lock();
    callback toggle-theme();
    callback theme-changed(int);
    callback ping-peer(string);
    callback forget-peer(string);
    callback update-peer-position(string, string);
    callback save-settings();
    callback auto-detect-screen();
    callback save-topology(string);
    callback save-topology-grid(string, int, int);
    callback filter-logs-level(int);
    callback filter-logs-text(string);
    callback copy-logs();
    callback refresh-logs();
    callback clear-logs();
    callback start-service();
    callback stop-service();
    callback restart-service();
    callback hide-to-tray();
    callback wizard-finish(int, string, string);

    // Modal actions
    callback open-connect-modal();
    callback open-unpair-modal(string);
    callback close-modal();
    callback modal-connect-submitted(string, string);
    callback modal-confirm-submitted();

    // ═════════════════════════════════════════════════════════════════════════
    // 1. SETUP WIZARD (First Launch)
    // ═════════════════════════════════════════════════════════════════════════
    if view == AppView.Wizard : SetupWizard {
        wizard-page <=> root.wizard-page;
        wizard-role <=> root.wizard-role;
        wizard-addr <=> root.wizard-addr;
        wizard-side <=> root.wizard-side;
        finish(role, addr, side) => {
            root.view = AppView.Connecting;
            root.wizard-finish(role, addr, side);
        }
    }

    // ═════════════════════════════════════════════════════════════════════════
    // 2. CONNECTING SPINNER
    // ═════════════════════════════════════════════════════════════════════════
    if view == AppView.Connecting : ConnectingView {
        status: root.status;
    }

    // ═════════════════════════════════════════════════════════════════════════
    // 3. MAIN TABBED INTERFACE
    // ═════════════════════════════════════════════════════════════════════════
    if view == AppView.Main : HorizontalBox {
        padding: 0px; spacing: 0px;

        // ── Sidebar Navigation ──────────────────────────────────────────────
        Sidebar {
            active-tab <=> root.active-tab;
            local-name: root.local-name;
            local-ip: root.local-ip;
            setting-port: root.setting-port;
            is-service-running: root.is-service-running;
            refresh-logs => { root.refresh-logs(); }
            toggle-theme => { root.toggle-theme(); }
        }

        // ── Main Content Body ───────────────────────────────────────────────
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.app-bg;

            VerticalBox {
                padding: 18px; spacing: 14px;

                // Header status bar with Live Controls
                HeaderBar {
                    active-tab: root.active-tab;
                    status: root.status;
                    is-service-running: root.is-service-running;
                    cursor-locked: root.cursor-locked;
                    tls-active: root.tls-active;
                    connected-peer: root.connected-peer;
                    toggle-cursor-lock => { root.toggle-cursor-lock(); }
                    start-service => { root.start-service(); }
                    stop-service => { root.stop-service(); }
                    restart-service => { root.restart-service(); }
                    hide-to-tray => { root.hide-to-tray(); }
                }

                // TAB 0: PEERS & CONNECTIONS
                if root.active-tab == 0 : PeersView {
                    role-label: root.role-label;
                    local-ip: root.local-ip;
                    setting-port: root.setting-port;
                    discovery: root.discovery;
                    connected-peer: root.connected-peer;
                    topology-configured: root.topology-configured;
                    topology-notice <=> root.topology-notice;
                    connection-error <=> root.connection-error;
                    is-service-running: root.is-service-running;
                    setting-tls: root.setting-tls;
                    tls-active: root.tls-active;
                    peers: root.peers;
                    configure-topology-clicked => { root.active-tab = 1; }
                    dismiss-error => { root.dismiss-error(); }
                    open-connect-modal => { root.open-connect-modal(); }
                    open-unpair-modal(addr) => { root.open-unpair-modal(addr); }
                    connect-requested(addr) => { root.connect-requested(addr); }
                    disconnect-requested => { root.disconnect-requested(); }
                    ping-peer(addr) => { root.ping-peer(addr); }
                    forget-peer(addr) => { root.forget-peer(addr); }
                    update-peer-position(addr, pos) => { root.update-peer-position(addr, pos); }
                }

                // TAB 1: SCREEN TOPOLOGY
                if root.active-tab == 1 : TopologyView {
                    peers: root.peers;
                    connected-peer: root.connected-peer;
                    setting-peer-pos <=> root.setting-peer-pos;
                    local-name: root.local-name;
                    local-ip: root.local-ip;
                    setting-port: root.setting-port;
                    setting-width: root.setting-width;
                    setting-height: root.setting-height;
                    settings-feedback: root.settings-feedback;
                    save-topology(pos) => { root.save-topology(pos); }
                    save-topology-grid(addr, gx, gy) => { root.save-topology-grid(addr, gx, gy); }
                }

                // TAB 4: FILE TRANSFERS & HISTORY
                if root.active-tab == 4 : TransfersView {
                    setting-file-transfer <=> root.setting-file-transfer;
                    active-transfers: root.active-transfers;
                    transfer-history: root.transfer-history;
                    toggle-file-transfer(enabled) => { root.toggle-file-transfer(enabled); }
                }

                // TAB 2: SETTINGS
                if root.active-tab == 2 : SettingsView {
                    setting-name <=> root.setting-name;
                    setting-role <=> root.setting-role;
                    setting-port <=> root.setting-port;
                    setting-discovery <=> root.setting-discovery;
                    setting-clipboard <=> root.setting-clipboard;
                    setting-file-transfer <=> root.setting-file-transfer;
                    setting-tls <=> root.setting-tls;
                    setting-autostart <=> root.setting-autostart;
                    setting-velocity <=> root.setting-velocity;
                    setting-switch-delay <=> root.setting-switch-delay;
                    setting-deadzone <=> root.setting-deadzone;
                    cursor-locked <=> root.cursor-locked;
                    setting-width <=> root.setting-width;
                    setting-height <=> root.setting-height;
                    setting-peer-addr <=> root.setting-peer-addr;
                    setting-peer-pos <=> root.setting-peer-pos;
                    setting-hotkey-lock <=> root.setting-hotkey-lock;
                    setting-hotkey-switch <=> root.setting-hotkey-switch;
                    setting-hotkey-escape <=> root.setting-hotkey-escape;
                    settings-feedback: root.settings-feedback;
                    toggle-file-transfer(enabled) => { root.toggle-file-transfer(enabled); }
                    toggle-tls(enabled) => { root.toggle-tls(enabled); }
                    auto-detect-screen => { root.auto-detect-screen(); }
                    save-settings => { root.save-settings(); }
                    theme-changed(idx) => { root.theme-changed(idx); }
                }

                // TAB 3: LOGS CONSOLE
                if root.active-tab == 3 : LogsView {
                    log-level-filter <=> root.log-level-filter;
                    log-filter <=> root.log-filter;
                    logs-feedback: root.logs-feedback;
                    log-lines: root.log-lines;
                    filter-logs-text(text) => { root.filter-logs-text(text); }
                    filter-logs-level(level) => { root.filter-logs-level(level); }
                    copy-logs => { root.copy-logs(); }
                    refresh-logs => { root.refresh-logs(); }
                    clear-logs => { root.clear-logs(); }
                }
            }
        }
    }

    // ═════════════════════════════════════════════════════════════════════════
    // 4. MODAL DIALOGS OVERLAY (Scrim + Centered Dialog)
    // ═════════════════════════════════════════════════════════════════════════
    if root.active-modal == 1 : ManualConnectModal {
        cancel => { root.close-modal(); }
        connect(addr, side) => { root.modal-connect-submitted(addr, side); }
    }

    if root.active-modal == 2 : ConfirmModal {
        title: root.modal-title != "" ? root.modal-title : "Unpair Machine";
        message: root.modal-message != "" ? root.modal-message : "Are you sure you want to unpair this machine?";
        confirm-text: "Unpair";
        is-destructive: true;
        cancel => { root.close-modal(); }
        confirm => { root.modal-confirm-submitted(); }
    }

    if root.active-modal == 3 : PairingPinModal {
        peer-name: root.modal-title != "" ? root.modal-title : "Peer";
        pin-code: root.modal-pin-code;
        cancel => { root.close-modal(); }
        confirm => { root.modal-confirm-submitted(); }
    }

    // ═════════════════════════════════════════════════════════════════════════
    // 5. FLOATING SNACKBAR / TOAST NOTIFICATION
    // ═════════════════════════════════════════════════════════════════════════
    Snackbar {
        show: root.toast-visible;
        message: root.toast-text;
        is-error: root.toast-is-error;
        dismiss => { root.dismiss-toast(); }
    }
}
